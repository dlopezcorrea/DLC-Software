# ──────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://crm_user:crm_pass@localhost:5432/crm_dev"

# ──────────────────────────────────────────────
# REDIS
# ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ──────────────────────────────────────────────
# AUTH
# ──────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret-32chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ──────────────────────────────────────────────
# APP
# ──────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:5173"

# ──────────────────────────────────────────────
# EMAIL (Nodemailer)
# ──────────────────────────────────────────────
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-pass"
SMTP_FROM_NAME="DLC CRM"
SMTP_FROM_EMAIL="no-reply@dlc-crm.com"

# ──────────────────────────────────────────────
# FILE STORAGE (S3 / MinIO)
# ──────────────────────────────────────────────
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="crm-files"
STORAGE_REGION="us-east-1"

# ──────────────────────────────────────────────
# STRIPE (Payments)
# ──────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
